<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Reproducible builds: same source -> same binary (stable PDB paths, no embedded timestamps). -->
    <Deterministic>true</Deterministic>
    <!-- Nullable reference types stay OFF deliberately (see ATENtion.App.csproj for the rationale). -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ATENtion.Core</RootNamespace>
    <AssemblyName>ATENtion.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.8</Version>
    <Product>ATENtion</Product>
    <Authors>Thomas Jones</Authors>
    <Company>Thomas Jones</Company>
    <Copyright>Copyright © 2026 Thomas Jones</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ATENtion.Tests" />
    <InternalsVisibleTo Include="ATENtion.Capture" />
  </ItemGroup>

</Project>
