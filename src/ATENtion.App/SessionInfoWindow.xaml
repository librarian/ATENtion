<Window x:Class="ATENtion.App.SessionInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Info"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#202020"
        Foreground="#DDD">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#DDD"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,3"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                Grid.Column="0"
                Text="Server"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="0"
                Grid.Column="1"
                x:Name="ServerText"
                Text="-"/>
        <TextBlock Grid.Row="1"
                Grid.Column="0"
                Text="Endpoint"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="1"
                Grid.Column="1"
                x:Name="EndpointText"
                Text="-"/>
        <TextBlock Grid.Row="2"
                Grid.Column="0"
                Text="Transport"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="2"
                Grid.Column="1"
                x:Name="TransportText"
                Text="-"/>
        <TextBlock Grid.Row="3"
                Grid.Column="0"
                Text="Resolution"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="3"
                Grid.Column="1"
                x:Name="ResolutionText"
                Text="-"/>
        <TextBlock Grid.Row="4"
                Grid.Column="0"
                Text="Mouse mode"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="4"
                Grid.Column="1"
                x:Name="MouseText"
                Text="-"/>
        <TextBlock Grid.Row="5"
                Grid.Column="0"
                Text="Control"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="5"
                Grid.Column="1"
                x:Name="ControlText"
                Text="-"/>
        <TextBlock Grid.Row="6"
                Grid.Column="0"
                Text="Session role"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="6"
                Grid.Column="1"
                x:Name="RoleText"
                Text="-"
                TextWrapping="Wrap"/>
        <TextBlock Grid.Row="7"
                Grid.Column="0"
                Text="Uptime"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="7"
                Grid.Column="1"
                x:Name="UptimeText"
                Text="-"/>
        <TextBlock Grid.Row="8"
                Grid.Column="0"
                Text="Throughput"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="8"
                Grid.Column="1"
                x:Name="ThroughputText"
                Text="-"/>
        <TextBlock Grid.Row="9"
                Grid.Column="0"
                Text="Totals"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="9"
                Grid.Column="1"
                x:Name="TotalsText"
                Text="-"/>
        <TextBlock Grid.Row="10"
                Grid.Column="0"
                Text="Last frame"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="10"
                Grid.Column="1"
                x:Name="LastFrameText"
                Text="-"/>
        <TextBlock Grid.Row="11"
                Grid.Column="0"
                Text="Reconnect"
                Foreground="#9AD"/>
        <TextBlock Grid.Row="11"
                Grid.Column="1"
                x:Name="ReconnectText"
                Text="-"/>
    </Grid>
</Window>
