<Window x:Class="ATENtion.App.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATENtion - Connect" Height="380" Width="420"
        Icon="atention.ico" Background="#202020" Foreground="#DDD"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDD" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDD" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#777" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkField" TargetType="Control">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="Padding" Value="3,2" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E1E1E" />
                    <Setter Property="Foreground" Value="#777" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkField}">
            <Setter Property="CaretBrush" Value="#EEE" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource DarkField}">
            <Setter Property="CaretBrush" Value="#EEE" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="30" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="BMC host/IP" VerticalAlignment="Center" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="HostBox" VerticalAlignment="Center" />

        <CheckBox  Grid.Row="1" Grid.Column="1" x:Name="ArmBox" Content="Open session via web (log in &amp; arm)"
                   IsChecked="True" VerticalAlignment="Center" Checked="OnArmToggled" Unchecked="OnArmToggled" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="BMC user" VerticalAlignment="Center" />
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="UserBox" Text="ADMIN" VerticalAlignment="Center" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="BMC password" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PassBox" VerticalAlignment="Center" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="iKVM port" VerticalAlignment="Center" />
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="PortBox" Text="5900" VerticalAlignment="Center"
                   ToolTip="Manual connections only. With 'Open session via web' on, the port comes from the BMC." />

        <TextBlock Grid.Row="5" Grid.Column="0" x:Name="TokenLabel" Text="Session token" VerticalAlignment="Center" />
        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TokenBox" VerticalAlignment="Center" />

        <CheckBox  Grid.Row="6" Grid.Column="1" x:Name="TlsBox" Content="Use TLS + client cert"
                   IsChecked="True" VerticalAlignment="Center"
                   ToolTip="Manual connections only. With 'Open session via web' on, TLS is set automatically from the BMC (JNLP stunEnable)." />

        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConnectBtn" Content="Connect" Width="90" Margin="0,0,8,0" IsDefault="True" Click="OnConnect" />
            <Button Content="Cancel" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
