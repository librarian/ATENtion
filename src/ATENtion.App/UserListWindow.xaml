<Window x:Class="ATENtion.App.UserListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connected Users"
        Width="440"
        Height="260"
        MinWidth="320"
        MinHeight="180"
        Background="#1E1E1E"
        Foreground="#DDD"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="#BBB"
                   Text="Console sessions the BMC currently reports. Each line is a session id, the user, and the client address it connects from."/>
        <TextBlock x:Name="CountText"
                   DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   Foreground="#9AD"
                   Text=""/>
        <ListBox x:Name="SessionList"
                 Background="#101010"
                 Foreground="#CFCFCF"
                 BorderBrush="#3A3A3A"
                 FontFamily="Consolas"
                 FontSize="12"/>
    </DockPanel>
</Window>
