<Window x:Class="ATENtion.App.CustomKeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send custom key combo" Width="320" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="atention.ico" Background="#202020" Foreground="#DDD">
    <StackPanel Margin="16">
        <TextBlock Text="Modifiers" Foreground="#9AD" Margin="0,0,0,4" />
        <WrapPanel>
            <CheckBox x:Name="CtrlBox" Content="Ctrl" Foreground="#DDD" Margin="0,0,14,0" />
            <CheckBox x:Name="AltBox" Content="Alt" Foreground="#DDD" Margin="0,0,14,0" />
            <CheckBox x:Name="ShiftBox" Content="Shift" Foreground="#DDD" Margin="0,0,14,0" />
            <CheckBox x:Name="WinBox" Content="Win" Foreground="#DDD" />
        </WrapPanel>

        <TextBlock Text="Key" Foreground="#9AD" Margin="0,12,0,4" />
        <ComboBox x:Name="KeyCombo" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Send" Width="84" Margin="0,0,8,0" IsDefault="True" Click="OnSend" />
            <Button Content="Cancel" Width="84" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
