<Window x:Class="ATENtion.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About ATENtion"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Icon="atention.ico"
        Background="#202020"
        Foreground="#DDD">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
                Grid.Column="0"
                Width="96"
                Height="96"
                VerticalAlignment="Top"
               Margin="0,0,18,0"
                Source="atention.png"
                RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Row="0"
                Grid.Column="1">
            <TextBlock Text="ATENtion"
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#3DE0CC"/>
            <TextBlock x:Name="VersionText"
                    Text="Version 1.0.0"
                    Foreground="#9AD"
                    Margin="0,2,0,10"/>
            <TextBlock TextWrapping="Wrap"
                    Foreground="#CCC"
                       Text="A native Windows console client for Supermicro/ATEN BMCs - IP KVM, virtual media, and power control. A clean-room C#/.NET Framework reimplementation of the ATEN Java iKVM viewer, reverse-engineered from the vendor binaries."/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                Grid.Column="1"
                Margin="0,14,0,0">
            <TextBlock x:Name="CopyrightText"
                    Foreground="#AAA"
                    FontSize="11"
                    Margin="0,0,0,4"/>
            <TextBlock x:Name="RuntimeText"
                    Foreground="#888"
                    FontSize="11"/>
            <TextBlock Foreground="#888"
                    FontSize="11"
                    TextWrapping="Wrap"
                       Text="Embeds Supermicro's public iKVM client certificate (CN=IPMI). Not affiliated with or endorsed by Supermicro or ATEN."/>
            <Button Content="OK"
                    Width="84"
                    Height="26"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
